# LLM Provider (at least one API key required)
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Shopify — only required in production; demo/dev works without it
SHOPIFY_STORE_DOMAIN=your-dev-store.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_API_VERSION=2026-01

# Database
DATABASE_URL=postgresql+asyncpg://inventory:inventory@localhost:5432/inventory_agent

# API Authentication
AGENT_API_KEY=your-api-key

# Environment (development / production)
# In production, ENVIRONMENT=production enforces Shopify credentials,
# requires PUBLIC_API_URL, and disables the demo API key.
ENVIRONMENT=development
PUBLIC_API_URL=http://localhost:8080

# Background Scheduler
# Enable for daily outcome evaluation + weekly reflection.
# Disable on all but one replica in multi-node deployments.
ENABLE_SCHEDULER=false

# Reverse Proxy Domain (for Caddy auto HTTPS)
# Leave empty for local HTTP. Set to your domain for Let's Encrypt SSL.
# Example: DOMAIN=inventory.example.com
DOMAIN=

# LLM Model Settings
MODEL_NAME=llama-3.1-8b-instant
TEMPERATURE=0.3
MAX_TOKENS=1024

# Frontend CORS (comma-separated)
# In production, set this to your actual domain.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Notifications
SLACK_WEBHOOK_URL=

# Shopify Webhooks (shared secret from Shopify App setup page)
SHOPIFY_WEBHOOK_SECRET=

# Checkpointer DB (for LangGraph pause/resume — psycopg scheme, not asyncpg)
CHECKPOINTER_DATABASE_URL=postgresql://inventory:inventory@localhost:5432/inventory_agent
