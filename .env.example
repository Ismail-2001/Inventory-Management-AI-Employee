# LLM Provider (at least one API key required)
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Shopify — only required in production; demo/dev works without it
SHOPIFY_STORE_DOMAIN=your-dev-store.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_API_VERSION=2026-01

# Database
DATABASE_URL=postgresql+asyncpg://inventory:inventory@localhost:5432/inventory_agent

# API Authentication
AGENT_API_KEY=your-api-key

# Optional Settings
ENVIRONMENT=development
MODEL_NAME=llama-3.1-8b-instant
TEMPERATURE=0.3
MAX_TOKENS=1024

# Notifications
SLACK_WEBHOOK_URL=

# Shopify Webhooks (shared secret from Shopify App setup page)
SHOPIFY_WEBHOOK_SECRET=

# Checkpointer DB (for LangGraph pause/resume — psycopg scheme, not asyncpg)
CHECKPOINTER_DATABASE_URL=postgresql://inventory:inventory@localhost:5432/inventory_agent
